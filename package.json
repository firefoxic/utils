{
	"name": "@firefoxic/utils",
	"description": "Collection of useful utilities for JavaScript and Node.js.",
	"version": "2.2.0",
	"license": "MIT",
	"author": {
		"name": "Sergey Artemov",
		"email": "firefoxic.dev@gmail.com"
	},
	"homepage": "https://github.com/firefoxic/utils#readme",
	"bugs": {
		"url": "https://github.com/firefoxic/utils/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/firefoxic/utils.git"
	},
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"get-node-matrix": "./dist/get-node-matrix.js"
	},
	"files": [
		"./dist/"
	],
	"engines": {
		"node": "^22.18 || ^24.15 || >=26.13"
	},
	"scripts": {
		"help": "make help",
		"prepare": "git config --local core.hooksPath .githooks || true"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26.13",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": ">=12.19",
			"onFail": "download"
		}
	},
	"devDependencies": {
		"@firefoxic/oxlint-config": "~0.6",
		"@types/node": "^26",
		"@vitest/coverage-v8": "^5",
		"oxlint": "^1",
		"tsrs": "^0.25.0-ts7",
		"vitest": "^5"
	},
	"keywords": [
		"javascript",
		"node.js",
		"prepare",
		"utils"
	]
}
